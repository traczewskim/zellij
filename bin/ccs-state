#!/usr/bin/env bash
# ccs-state <working|attn|idle>
#
# Claude Code hook helper. Retitles THIS pane in the Zellij vertical tab bar,
# so the sidebar shows a real running/idle indicator instead of Claude's own
# terminal title (whose glyph is present in both states and animates at ~10Hz,
# so the sidebar can only ever sample it arbitrarily).
#
# Renames by pane id, so it never steals focus from another tab. An explicit
# pane name permanently outranks the OSC title, which is what makes it stable.
# No-ops outside Zellij, and for any Claude session that is not a ccs slot.
set -uo pipefail
state="${1:-idle}"

[ -n "${ZELLIJ_PANE_ID:-}" ] || exit 0

payload=$(cat 2>/dev/null || true)
sid=$(printf '%s' "$payload" \
      | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([0-9a-fA-F-]\{36\}\)".*/\1/p' \
      | head -1)
[ -n "$sid" ] || exit 0

# Label: a registered slot name if there is one, else the pane's directory.
# NOT requiring a slot is deliberate — the indicator must work for every
# Claude pane, not only ccs-managed ones. Tying it to claude-slots made it
# silently inert for hand-made tabs (see F14/F15).
slot=$(awk -v u="$sid" '$2 == u { print $1; exit }' "$HOME/.config/claude-slots" 2>/dev/null || true)
# Then Claude's own session name — what `/rename` and `ccs`'s --name set.
# Zellij tab names cannot be used: the sidebar plugin's only placeholders are
# {count} {index} {indicators} {name}, and {name} is the PANE, so `Ctrl+t R`
# never reaches this row. /rename is the one control surface users have.
if [ -z "$slot" ]; then
    slot=$(python3 - "$sid" <<'PY' 2>/dev/null || true
import glob, json, os, sys
best = ("", 0)
for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    if d.get("sessionId") == sys.argv[1] and d.get("name"):
        m = os.path.getmtime(f)
        if m > best[1]:
            best = (d["name"], m)
print(best[0])
PY
)
fi

# Last resort: the pane's directory. Drifts as the cwd moves, so it is only
# a placeholder until the session is named.
if [ -z "$slot" ]; then
    cwd=$(printf '%s' "$payload" \
          | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    slot=$(basename "${cwd:-$PWD}")
    [ -n "$slot" ] && [ "$slot" != "/" ] || slot="claude"
fi

case "$state" in
    working) name="🟢 $slot" ;;
    attn)    name="🟡 $slot" ;;
    *)       name="⚪ $slot" ;;
esac

zellij action rename-pane -p "$ZELLIJ_PANE_ID" "$name" >/dev/null 2>&1 || true
exit 0
